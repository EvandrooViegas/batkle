CORS_ORIGINS=

OPENAI_API_KEY=
MONGO_URL=
DB_NAME=
NEXT_PUBLIC_BASE_URL=
GROQ_API_KEY=

UNSPLASH_ACCESS_KEY=
FAL_KEY=
POLLINATIONS_API_KEY=

# Backup Groq credential for server-side rate-limit failover
GROQ_API_KEY_2=
GLOBAL_DESIGN_ADMIN_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Developer API: the credits a new account starts with (100 when empty). Add more with scripts/grant-credits.cjs.
DEVELOPER_FREE_CREDITS=

# Payments (Stripe). Plans and prices live in lib/billing/plans.ts; scripts/stripe-setup.cjs creates them in Stripe.
# The webhook endpoint is <base URL>/api/stripe/webhook; STRIPE_WEBHOOK_SECRET is its signing secret (whsec_…).
# Locally, `npm run dev` forwards test-mode webhooks with the Stripe CLI and supplies its own secret (scripts/dev.cjs).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend): reminders and the newsletter discount. EMAIL_FROM must use a domain verified in Resend,
# e.g. Batkle <reminders@your-domain.com>.
RESEND_API_KEY=
EMAIL_FROM=
# Where "Contact us" (more than 5 brands) and email replies go.
NEXT_PUBLIC_CONTACT_EMAIL=

# Text reminders (Twilio). TWILIO_MESSAGING_SERVICE_SID (MG…) or TWILIO_FROM_NUMBER (+1…) sends the texts;
# TWILIO_VERIFY_SERVICE_SID (VA…) checks phone numbers with a code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Image storage (Cloudflare R2). Without these, images stay in MongoDB as before.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The reminders job (/api/cron/reminders) must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=